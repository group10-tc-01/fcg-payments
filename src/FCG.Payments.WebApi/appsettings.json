{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=fcg_payments;TrustServerCertificate=True;"
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "Payments"
  },
  "KafkaSettings": {
    "BootstrapServers": "localhost:9092",
    "UseSaslSsl": false,
    "UserCreatedTopic": "user-created",
    "SaslUsername": "",
    "SaslPassword": "",
    "GroupId": "fcg-payments-consumer-group",
    "Topics": {
      "UserCreated": "user-created",
      "OrderPlaced": "order-placed",
      "PaymentProcessed": "payment-processed"
    }
  },
  "Observability": {
    "ServiceName": "FCG.Payments",
    "OtlpEndpoint": "",
    "OtlpAuthHeader": "",
    "EnableOtlpExporter": false
  },
  "JwtSettings": {
    "SecretKey": "change-me-use-user-secrets-or-key-vault",
    "Issuer": "FCG-User",
    "Audience": "FCG-Client"
  }
}
